# MikroManager - instellingen voor de systemd-service.
# Na wijzigen: sudo systemctl restart mikromanager

# Waar de webinterface luistert. 0.0.0.0 = alle adressen, 127.0.0.1 = alleen achter een reverse proxy op deze host.
MM_HOST=0.0.0.0
MM_PORT=8080

# Adressen van reverse proxies (Pangolin/Traefik) waarvan X-Forwarded-* wordt vertrouwd, komma-gescheiden.
MM_TRUSTED_PROXIES=127.0.0.1

# Database, secret.key en back-ups. Niet wijzigen: systemd maakt deze map aan (StateDirectory).
TIKCONTROL_DATA=/var/lib/mikromanager

# Seconden tussen metingen
TIKCONTROL_POLL=15

# Op 1 zetten als MikroManager via HTTPS (reverse proxy) wordt aangeboden
TIKCONTROL_SECURE_COOKIE=0

# Op 1 zetten voor gesimuleerde routers (data in /var/lib/mikromanager/demo, gewist bij elke start)
TIKCONTROL_DEMO=0

# Het back-upschema gebruikt de tijdzone van het systeem (timedatectl). Alleen invullen om die te overschrijven:
# TZ=Europe/Amsterdam
